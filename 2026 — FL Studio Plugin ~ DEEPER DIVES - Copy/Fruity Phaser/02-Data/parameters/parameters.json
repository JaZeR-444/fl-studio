{
  "pluginName": "Fruity Phaser",
  "parameters": [
    {
      "id": "stages",
      "name": "Stages",
      "type": "selector",
      "options": ["2", "4", "6", "8", "etc"],
      "defaultValue": "4",
      "description": "Number of all-pass filter stages."
    },
    {
      "id": "min_depth",
      "name": "Min Depth",
      "type": "knob",
      "range": { "min": 0, "max": 100, "unit": "%" },
      "defaultValue": 0,
      "description": "Lowest point of the LFO sweep."
    },
    {
      "id": "max_depth",
      "name": "Max Depth",
      "type": "knob",
      "range": { "min": 0, "max": 100, "unit": "%" },
      "defaultValue": 100,
      "description": "Highest point of the LFO sweep."
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "knob",
      "range": { "min": 0, "max": 5, "unit": "Hz" },
      "defaultValue": 0.2,
      "description": "Rate of the LFO modulation."
    }
  ]
}
