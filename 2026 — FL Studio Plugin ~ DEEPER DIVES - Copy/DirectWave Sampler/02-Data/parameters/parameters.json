{
  "pluginName": "DirectWave",
  "category": "Sampler / Rompler",
  "parameters": [
    {
      "section": "Zone",
      "id": "root_key",
      "name": "Root Note",
      "range": { "min": 0, "max": 127, "unit": "Note" },
      "description": "The pitch where the sample plays at original speed."
    },
    {
      "section": "Filter",
      "id": "filter_type",
      "name": "Filter Type",
      "options": [
        "Off",
        "LowPass",
        "HighPass",
        "BandPass",
        "Notch",
        "AllPass",
        "MiniSynth",
        "Vox"
      ],
      "description": "Algorithm used for the synthesis filter."
    },
    {
      "section": "Filter",
      "id": "cutoff",
      "name": "Cutoff Frequency",
      "range": { "min": 10, "max": 20000, "unit": "Hz" },
      "description": "Filter corner frequency."
    },
    {
      "section": "Envelope",
      "id": "amp_attack",
      "name": "Amp Attack",
      "range": { "min": 0, "max": 10000, "unit": "ms" },
      "description": "Volume fade-in time."
    },
    {
      "section": "Effects (Per Voice)",
      "id": "decimator_mix",
      "name": "Decimator Mix",
      "range": { "min": 0, "max": 100, "unit": "%" },
      "description": "Bitcrusher dry/wet mix."
    },
    {
      "section": "Effects (Global)",
      "id": "reverb_send",
      "name": "Reverb Send",
      "range": { "min": 0, "max": 100, "unit": "%" },
      "description": "Send level to the global Reverb unit."
    },
    {
      "section": "Modulation",
      "id": "lfo1_rate",
      "name": "LFO 1 Rate",
      "range": { "min": 0, "max": 20, "unit": "Hz" },
      "description": "Speed of Low Frequency Oscillator 1."
    }
  ]
}
