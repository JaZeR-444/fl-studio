{
  "presetArchetypes": {
    "lofiKeys": {
      "description": "Warm, degraded piano for hip-hop",
      "settings": {
        "category": "Piano",
        "position": 50,
        "mutate": 0,
        "resample": 30,
        "filter": { "type": "lowpass", "cutoff": 75, "resonance": 20 },
