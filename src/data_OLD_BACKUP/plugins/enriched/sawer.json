      "archetypes": [
        {
          "name": "Polivoks Bass",
          "goal": "Gritty low-end with aggressive resonance",
          "focus": [
            "LP24",
            "moderate resonance",
            "sub oscillator phase"
          ],
          "verifyInApp": true
        },
        {
          "name": "Sync Lead",
          "goal": "Tearing lead with sync movement",
          "focus": [
            "sync enabled",
            "higher cutoff",
            "phaser"
          ],
          "verifyInApp": true
        },
        {
          "name": "Vintage Brass",
          "goal": "Short, bright stabs",
          "focus": [
            "LP12",
            "short decay",
            "low resonance"
          ],
          "verifyInApp": true
