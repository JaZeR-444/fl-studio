            {
              "value": "hann",
              "label": "Hann",
              "description": "Good balance of frequency and amplitude accuracy",
              "use_cases": [
                "balanced_analysis",
                "general_use"
              ]
            },
            {
              "value": "hamming",
              "label": "Hamming",
              "description": "Reduced spectral leakage",
              "use_cases": [
                "leakage_reduction",
                "clean_spectrum"
              ]
            },
            {
              "value": "blackman",
              "label": "Blackman",
              "description": "Excellent for general analysis",
              "use_cases": [
                "general_analysis",
                "smooth_display"
              ]
            }
          ],
          "description": "Determines the FFT window type affecting frequency vs. time resolution",
          "use_cases": [
            "spectral_analysis",
            "resolution_tradeoffs"
          ],
          "hip_hop_applications": [
            "808_harmonic_analysis",
            "vocal_frequency_clarity"
