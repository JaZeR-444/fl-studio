  "presets": {
    "01-rhythmic-width": {
      "name": "Rhythmic Width",
      "genre": "universal",
      "mood": "electric",
      "description": "Different delay times per band for rhythmic width",
      "parameters": {
        "lowBand": {
          "time": 120,
          "feedback": 40,
          "mix": 30
        },
        "midBand": {
          "time": 240,
          "feedback": 50,
          "mix": 40
        },
        "highBand": {
          "time": 360,
          "feedback": 30,
          "mix": 50
        }
      },
      "workflow": {
        "useCase": "Adding rhythmic width",
        "steps": [
          "Set low band short",
          "Set mid band double",
          "Set high band triple",
          "Blend to taste"
        ],
        "troubleshooting": [
          {
            "issue": "Too busy",
            "fix": "Reduce mix levels"
          },
          {
            "issue": "Phasing",
            "fix": "Shorten delay times"
          }
        ]
      },
      "abTest": {
        "listenFor": "Rhythmic, dimensional sound",
        "duration": "Full mix"
      }
    },
