  "troubleshooting": [
    {
      "issue": "Sound too bright/harsh",
      "solution": "Lower Cutoff OR apply LP filter @ 8kHz (Anti-Fizz)"
    },
    {
      "issue": "Sound too dark/dull",
      "solution": "Raise Cutoff OR check if Master Filter LP is active (disable it)"
    },
    {
      "issue": "Too wet/reverby",
      "solution": "Lower Reverb Mix to 0-20% OR check Macros 5-8"
    },
    {
      "issue": "Sound never stops",
      "solution": "Lower Release (R) to 5-15% OR reduce Sustain level"
    },
    {
      "issue": "Unwanted rhythm/arp",
      "solution": "Click Arp icon to grey (disable arpeggiator)"
    },
    {
      "issue": "Bass not mono",
      "solution": "Lower Width/Unison macro to 0% - check vectorscope (must be vertical)"
    },
    {
      "issue": "Using too much CPU",
      "solution": "Lower Unison/Voices, freeze tracks, disable visualizers"
    },
    {
      "issue": "Sound cuts off early",
      "solution": "Increase Release OR raise polyphony setting OR increase Sustain"
    },
    {
      "issue": "Clicking/popping",
      "solution": "Increase Attack to 5-10ms OR increase buffer size"
    },
    {
      "issue": "Thin/weak sound",
      "solution": "Check HP filter setting, add sub layer from another FLEX"
    },
    {
      "issue": "Phase issues",
      "solution": "Check vectorscope (should be vertical for bass), reduce stereo width"
    },
    { "issue": "Muddy mix", "solution": "HP everything except bass @ 180Hz" },
    {
      "issue": "Harsh high-end",
      "solution": "Lower Resonance OR apply LP filter @ 9kHz"
    },
    {
      "issue": "No movement/boring",
      "solution": "Automate Macros 1-2 and filter cutoff - static presets sound amateur"
    },
    {
      "issue": "Preset sounds wrong",
      "solution": "Alt + Click all macros to reset to designer defaults"
    },
    {
      "issue": "Volume changes when browsing",
      "solution": "Lock Master Volume with padlock icon"
    }
  ],

