    "oscillator2": { "waveform": "saw", "octave": "0", "detune": 7, "mix": 85 },
    "oscillator3": { "waveform": "saw", "octave": "0", "detune": 14, "mix": 80 },
    "oscillator4": { "waveform": "saw", "octave": "+1", "detune": 21, "mix": 65 },
