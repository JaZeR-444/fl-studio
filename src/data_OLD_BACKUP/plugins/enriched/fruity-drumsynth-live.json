      "psychedelicPatches": [
        {
          "name": "Drunken Tom",
          "settings": {
            "osc1": "80Hz",
            "osc2": "Link to LFO for pitch drift",
            "noise": "20%",
            "decay": "70%"
          },
          "vibe": "Trippy, pitch-sliding low percussion."
        },
        {
          "name": "Alien Shaker",
          "settings": {
            "osc1": "4500Hz",
            "noise": "100%",
            "res": "95%",
            "decay": "5%"
          },
          "vibe": "Resonant, metallic noise bursts."
        }
      ]
    }
