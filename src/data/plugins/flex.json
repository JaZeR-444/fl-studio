  "controls": [
    {
      "label": "Macros 1-8",
      "description": "Custom meta-controls specific to each preset. One macro often controls 10+ underlying parameters simultaneously.",
      "listenFor": "Timbral transformations, filter sweeps, effect changes depending on preset"
    },
    {
      "label": "Cutoff",
      "description": "Controls brightness by filtering frequencies above (LP) or below (HP) the cutoff point. Range: 20Hz-20kHz.",
      "listenFor": "Brightness changes - lower = darker/warmer, higher = brighter/harsher"
    },
    {
      "label": "Resonance",
      "description": "Boosts frequencies around cutoff point. 0-100%. High values (70-90%) create acid squelch.",
      "listenFor": "70-90% = acid squelch, 30-50% = character, 0-20% = clean"
    },
    {
      "label": "Env Amt",
      "description": "Controls how much envelope modulates filter cutoff. -100% to +100%.",
      "listenFor": "Positive = 'wah' opening, Negative = 'ow' closing"
    },
    {
      "label": "Attack (A)",
      "description": "Time from 0% to 100% volume after key press. 0% = instant, 70% = slow fade.",
      "listenFor": "0% for percussion/plucks, 25-50% for strings, 70-90% for pads"
    },
    {
      "label": "Hold (H)",
      "description": "Time at peak level before decay starts.",
      "listenFor": "Short (0-10%) most sounds, long (50%+) for organ-like sustain"
    },
    {
      "label": "Decay (D)",
      "description": "Time from peak level down to sustain level.",
      "listenFor": "Short = punchy, long = slow transitions"
    },
    {
      "label": "Sustain (S)",
      "description": "Volume LEVEL (not time!) maintained while key held. 100% = full, 0% = silent.",
      "listenFor": "100% for pads, 0% for plucks, 50% for piano"
    },
    {
      "label": "Release (R)",
      "description": "Time from current level to 0% after key release.",
      "listenFor": "5-15% for tight bass, 30-50% for strings, 70-90% for pads"
    }
  ],

