{
  "id": "beepmap",
  "name": "BeepMap",
  "presets": {},
  "parameters": {
    "beepmap-specs": {
      "plugin_name": "BeepMap",
      "category": "Instrument / Experimental",
      "engine": "Image-to-Spectral-Synthesis",
      "parameters": [
        {
          "name": "Frequency (Hz)",
          "type": "knob",
          "description": "Base frequency of the image's bottom pixels.",
          "vibe_impact": "Pitch, range, mood"
        },
        {
          "name": "Length (ms)",
          "type": "knob",
          "description": "Scanning duration from left to right.",
          "vibe_impact": "Speed, timing, rhythm"
        },
        {
          "name": "Grain",
          "type": "knob",
          "description": "The density of the scan resolution.",
          "vibe_impact": "Smoothness, digital grit, artifacts"
        },
        {
          "name": "Scale (Log/Lin)",
          "type": "switch",
          "description": "Determines frequency distribution mapping.",
          "vibe_impact": "Musicality, tuning, focus"
        }
      ],
      "mix_impact_tags": [
        "spectral",
        "unpredictable",
        "atmospheric"
      ]
    },
    "parameters": {
      "pluginName": "BeepMap",
      "category": "Image Synth / Sonifier",
      "parameters": [
        {
          "section": "Global",
          "id": "freq",
          "name": "Frequency Range",
          "range": {
            "min": 20,
            "max": 22000,
            "unit": "Hz"
          },
          "description": "Sets the maximum pitch for the top pixel row."
        },
        {
          "section": "Global",
          "id": "length",
          "name": "Pixel Duration",
          "range": {
            "min": 1,
            "max": 5000,
            "unit": "ms"
          },
          "description": "Scan speed per pixel column."
        },
        {
          "section": "Global",
          "id": "scale",
          "name": "Scale Mode",
          "options": [
            "Linear (Hz)",
            "Log (Cents)"
          ],
          "description": "Mapping of Y-axis to Pitch."
        },
        {
          "section": "Tone",
          "id": "use_blue",
          "name": "Use Blue",
          "type": "Switch",
          "description": "Enables Blue channel to modulate frequency range per pixel."
        },
        {
          "section": "Tone",
          "id": "grainy",
          "name": "Grainy",
          "type": "Switch",
          "description": "Enables granular synthesis mode (Geiger effect)."
        },
        {
          "section": "Playback",
          "id": "loop",
          "name": "Loop Mode",
          "type": "Switch",
          "description": "Repeats the image scan continuously."
        },
        {
          "section": "Output",
          "id": "widen",
          "name": "Widen",
          "range": {
            "min": 0,
            "max": 100,
            "unit": "%"
          },
          "description": "Stereo width enhancer."
        },
        {
          "section": "System",
          "id": "max_bitmap_height",
          "name": "Max Bitmap Height",
          "range": {
            "min": 10,
            "max": 999,
            "unit": "px"
          },
          "description": "Number of sine wave oscillators (CPU Load)."
        }
      ]
    }
  },
