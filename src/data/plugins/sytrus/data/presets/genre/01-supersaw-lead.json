{
  "name": "SuperSaw Lead",
  "genre": "EDM",
  "mood": "electric",
  "description": "Massive stacked saw lead for festival anthems",
  "parameters": {
    "op1": { "wave": 2, "mix": 100, "detune": 0, "phase": 0 },
    "op2": { "wave": 2, "mix": 90, "detune": 5, "phase": 0 },
    "op3": { "wave": 2, "mix": 80, "detune": 10, "phase": 0 },
    "op4": { "wave": 2, "mix": 70, "detune": -5, "phase": 0 },
    "op5": { "wave": 2, "mix": 60, "detune": -10, "phase": 0 },
    "op6": { "wave": 2, "mix": 50, "detune": 15, "phase": 0 },
    "cutoff": 4800,
    "resonance": 35,
    "drive": 15,
    "ampAttack": 5,
    "ampDecay": 200,
    "ampSustain": 85,
    "ampRelease": 150,
    "reverbMix": 25,
    "delayMix": 20
  },
  "workflow": {
    "useCase": "Main festival lead melodies",
    "steps": [
      "Use 6 operators for full stack",
      "Detune adjacent operators (+/- 5-15 cents)",
      "Cutoff around 4800 Hz for presence",
      "Light drive (15%) for warmth",
      "Fast attack for immediate presence"
    ],
    "troubleshooting": [
      { "issue": "Phasing in mono", "fix": "Reduce detune spread to 10 cents" },
      { "issue": "Too harsh", "fix": "Increase cutoff to 6000 Hz, reduce drive" },
      { "issue": "No width", "fix": "Use Haas effect or chorus" }
    ]
  },
  "abTest": {
    "listenFor": "Massive, detuned saw stack with presence",
    "duration": "Full melodic phrase"
  }
}