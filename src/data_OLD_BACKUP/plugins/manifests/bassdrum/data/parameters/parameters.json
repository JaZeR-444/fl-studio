{
  "pluginName": "BassDrum",
  "category": "Drum Synthesizer",
  "parameters": [
    {
      "section": "Main Oscillator",
      "id": "main_base",
      "name": "Base Frequency",
      "range": { "min": 20, "max": 1000, "unit": "Hz" },
      "description": "End frequency of the slide (Fundamental)."
    },
    {
      "section": "Main Oscillator",
      "id": "main_peak",
      "name": "Peak Frequency",
      "range": { "min": 20, "max": 1000, "unit": "Hz" },
      "description": "Start frequency of the slide."
    },
    {
      "section": "Main Oscillator",
      "id": "main_slide",
      "name": "Slide Time",
      "range": { "min": 0, "max": 2000, "unit": "ms" },
      "description": "Duration of the pitch drop."
    },
    {
      "section": "Slave Oscillator",
      "id": "slave_phase",
      "name": "Phase Offset",
      "range": { "min": 0, "max": 360, "unit": "degrees" },
      "description": "Delay of Slave relative to Main."
    },
    {
      "section": "Sample Layer",
      "id": "sample_delay",
      "name": "Layer Timing",
      "range": { "min": -100, "max": 100, "unit": "%" },
      "description": "Negative = Pre-delay. Positive = Post-delay."
    },
    {
      "section": "Global",
      "id": "sampling_ratio",
      "name": "Sampling Ratio",
      "range": { "min": 0, "max": 100, "unit": "%" },
      "description": "Resampling quality. Low = Aliasing/Grit."
    },
    {
      "section": "Global",
      "id": "duration",
      "name": "Note Duration",
      "range": { "min": 0, "max": 5000, "unit": "ms" },
      "description": "Master gate time. Ignores MIDI Note Off."
    }
  ]
}
