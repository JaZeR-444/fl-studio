{
  "presetName": "Upbeat Bounce",
  "genre": "Upbeat Hip-Hop",
  "application": "Energetic beats with consistent punch and movement",
  "parameters": {
    "lowBand": {
      "threshold": -15,
      "ratio": 3.0,
      "attack": 10,
      "release": 120,
      "gain": 0.5
    },
    "midBand": {
      "threshold": -10,
      "ratio": 2.5,
      "attack": 5,
      "release": 90,
      "gain": 1.0
    },
    "highBand": {
      "threshold": -12,
      "ratio": 2.0,
      "attack": 1,
      "release": 60,
      "gain": 0.5
    },
    "crossovers": {
      "lowMid": 200,
      "midHigh": 5000
    },
    "globalSettings": {
      "outputGain": 1.0,
      "mix": 100
    }
  },
  "description": "Moderate compression across all bands for consistent energy and forward momentum",
  "tags": ["upbeat", "energetic", "bounce", "club", "master"]
}
