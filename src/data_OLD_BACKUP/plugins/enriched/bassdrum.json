{
  "id": "bassdrum",
  "name": "BassDrum",
  "presets": {},
  "parameters": {
    "bassdrum-params": {
      "plugin_name": "BassDrum",
      "category": "Instrument / Drum",
      "engine": "Hybrid Sine-Sweep & Sample-Layer core",
      "parameters": [
        {
          "name": "Start Freq",
          "type": "knob",
          "unit": "Hz",
          "description": "Initial frequency of the pitch sweep.",
          "vibe_impact": "Punch, knock, presence"
        },
        {
          "name": "End Freq",
          "type": "knob",
          "unit": "Hz",
          "description": "Final frequency of the pitch sweep (The Root).",
          "vibe_impact": "Key matching, depth, weight"
        },
        {
          "name": "Pitch Decay",
          "type": "knob",
          "description": "Speed of the pitch drop.",
          "vibe_impact": "Rhythm, timing, energy"
        },
        {
          "name": "Sample Type",
          "type": "selector",
          "description": "Selects the internal attack transient.",
          "vibe_impact": "Texture, identity"
        },
        {
          "name": "Drive Type",
          "type": "selector",
          "values": [
            "Soft",
            "Hard",
            "Clip",
            "Tube"
          ],
          "vibe_impact": "Aggression, grit, warmth"
        }
      ],
      "mix_impact_tags": [
        "sub-bass",
        "transient",
        "loudness"
      ]
    },
    "bassdrum-specs": {
      "plugin_name": "BassDrum",
      "engine_type": "Hybrid Kick Synth",
      "oscillators": 2,
      "sample_slots": 1,
      "features": [
        "Frequency Slide",
        "Internal Sample Rate Manipulation",
        "Phase Alignment Control"
      ]
    },
    "parameters": {
      "pluginName": "BassDrum",
      "category": "Drum Synthesizer",
      "parameters": [
        {
          "section": "Main Oscillator",
          "id": "main_base",
          "name": "Base Frequency",
          "range": {
            "min": 20,
            "max": 1000,
            "unit": "Hz"
          },
          "description": "End frequency of the slide (Fundamental)."
        },
        {
          "section": "Main Oscillator",
          "id": "main_peak",
          "name": "Peak Frequency",
          "range": {
            "min": 20,
            "max": 1000,
            "unit": "Hz"
          },
          "description": "Start frequency of the slide."
        },
        {
          "section": "Main Oscillator",
          "id": "main_slide",
          "name": "Slide Time",
          "range": {
            "min": 0,
            "max": 2000,
            "unit": "ms"
          },
          "description": "Duration of the pitch drop."
        },
        {
          "section": "Slave Oscillator",
          "id": "slave_phase",
          "name": "Phase Offset",
          "range": {
            "min": 0,
            "max": 360,
            "unit": "degrees"
          },
          "description": "Delay of Slave relative to Main."
        },
        {
          "section": "Sample Layer",
          "id": "sample_delay",
          "name": "Layer Timing",
          "range": {
            "min": -100,
            "max": 100,
            "unit": "%"
          },
          "description": "Negative = Pre-delay. Positive = Post-delay."
        },
        {
          "section": "Global",
          "id": "sampling_ratio",
          "name": "Sampling Ratio",
          "range": {
            "min": 0,
            "max": 100,
            "unit": "%"
          },
          "description": "Resampling quality. Low = Aliasing/Grit."
        },
        {
          "section": "Global",
          "id": "duration",
          "name": "Note Duration",
          "range": {
            "min": 0,
            "max": 5000,
            "unit": "ms"
          },
          "description": "Master gate time. Ignores MIDI Note Off."
        }
      ]
    }
  },
