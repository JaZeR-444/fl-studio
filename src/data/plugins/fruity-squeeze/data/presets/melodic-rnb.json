{
  "presetName": "Melodic R&B Polish",
  "genre": "Melodic/R&B Hip-Hop",
  "application": "Smooth, polished production for melodic rap and R&B",
  "parameters": {
    "lowBand": {
      "threshold": -20,
      "ratio": 2.0,
      "attack": 20,
      "release": 150,
      "gain": 0
    },
    "midBand": {
      "threshold": -15,
      "ratio": 1.5,
      "attack": 15,
      "release": 100,
      "gain": 0.5
    },
    "highBand": {
      "threshold": -18,
      "ratio": 1.5,
      "attack": 3,
      "release": 80,
      "gain": 0
    },
    "crossovers": {
      "lowMid": 180,
      "midHigh": 6000
    },
    "globalSettings": {
      "outputGain": 0.3,
      "mix": 85
    }
  },
  "description": "Gentle compression for smooth, transparent sound with vocal clarity",
  "tags": ["melodic", "rnb", "smooth", "vocals", "polished"]
}
