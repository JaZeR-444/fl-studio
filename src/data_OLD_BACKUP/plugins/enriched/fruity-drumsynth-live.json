  "parameters": {
    "drumsynth-live-specs": {
      "plugin": {
        "name": "Fruity DrumSynth Live",
        "category": "Instrument",
        "type": "Percussion Synthesizer",
        "officialManual": "https://www.image-line.com/fl-studio-learning/fl-studio-online-manual/html/plugins/Fruity%20DrumSynth%20Live.htm"
      },
      "parameters": {
