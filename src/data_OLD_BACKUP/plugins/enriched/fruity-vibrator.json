    "hip-hop-mappings": {
      "pluginName": "Fruity Vibrator",
      "version": "1.0",
      "presetCategory": "Hip-Hop MIDI Mappings",
      "description": "Optimized MIDI-to-haptic mappings for various hip-hop and rap subgenres",
