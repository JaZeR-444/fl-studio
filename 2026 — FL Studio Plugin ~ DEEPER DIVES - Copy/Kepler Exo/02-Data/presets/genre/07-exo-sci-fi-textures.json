  "chain": {
    "pre": ["Fruily Parametric EQ 2 - Multi-band processing"],
    "post": ["Fruily Reverb 2 - Gated, Decay 1.5s, Mix 40%", "Delay - Stereo ping-pong, 600ms, Feedback 50%"]
