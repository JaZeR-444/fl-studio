    "electro-hip-hop": {
      "name": "Electro Hip-Hop",
      "genre": "hip-hop/rap",
      "mood": "electric",
      "description": "Electronic-infused processing for electro hip-hop",
      "parameters": {
        "chain": [
          {
            "slot": 1,
            "type": "EQ",
            "plugin": "Fruity Parametric EQ 2",
            "settings": {
              "highPass": "50Hz",
              "bell": "+3dB at 4kHz",
              "highShelf": "+3dB at 10kHz"
            }
          },
          {
            "slot": 2,
            "type": "Distortion",
            "plugin": "Fruity Distock",
            "settings": {
              "drive": "20%",
              "tone": "70%"
            }
          },
          {
            "slot": 3,
            "type": "Compressor",
            "plugin": "Fruity Compressor",
            "settings": {
              "ratio": "6:1",
              "attack": "2ms",
              "release": "60ms",
              "threshold": "-22dB"
            }
          }
        ],
        "characteristics": [
          "Electronic edge",
          "Aggressive transients",
          "Modern sound"
        ]
      },
      "workflow": {
        "useCase": "Electro hip-hop, experimental rap",
