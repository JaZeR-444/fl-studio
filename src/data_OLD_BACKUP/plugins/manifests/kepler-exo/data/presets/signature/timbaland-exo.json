  "characteristics": ["experimental", "unconventional", "forward-thinking", "textural"],
  "genreTags": ["hip-hop/rap", "experimental", "innovative"],
  "a/bTesting": {
    "testA": "Extreme modulation for weird textures",
    "testB": "Milder modulation for usable sounds"
