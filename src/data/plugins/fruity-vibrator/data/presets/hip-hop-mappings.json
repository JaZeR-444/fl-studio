          "tips": "Important for authentic boom bap flavor"
        }
      ],
      "globalSettings": {
        "masterIntensity": 70,
        "velocitySensitivity": "Medium",
        "polyphony": "Unlimited",
        "notes": "Balanced intensity for classic boom bap feel"
      }
    },
