      },
      "troubleshooting": {
        "muddyArrangement": "High-pass synth at 300Hz except on bass notes",
        "maskingVocals": "Notch EQ at 2-3kHz on synth"
      }
    },
    "sounwave": {
      "name": "West Coast Drfill",
