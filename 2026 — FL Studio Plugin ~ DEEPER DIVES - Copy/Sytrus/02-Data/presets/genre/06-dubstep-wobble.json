{
  "name": "Dubstep Wobble",
  "genre": "EDM",
  "mood": "electric",
  "description": "Aggressive wobble bass with LFO modulation",
  "parameters": {
    "op1": { "wave": 1, "mix": 100, "detune": 0, "phase": 0 },
    "op2": { "wave": 2, "mix": 85, "detune": 0, "phase": 0 },
    "op3": { "wave": 2, "mix": 70, "detune": 0, "phase": 0 },
    "op4": { "wave": 1, "mix": 0, "detune": 0, "phase": 0 },
    "op5": { "wave": 2, "mix": 0, "detune": 0, "phase": 0 },
    "op6": { "wave": 2, "mix": 0, "detune": 0, "phase": 0 },
    "cutoff": 3500,
    "resonance": 75,
    "drive": 40,
    "ampAttack": 5,
    "ampDecay": 200,
    "ampSustain": 80,
    "ampRelease": 150,
    "reverbMix": 20,
    "delayMix": 15,
