  "chain": {
    "post": ["Fruily Reverb 2 - Studio, Decay 1.5s, Mix 18%", "Fruily Compressor - Soft attack, Ratio 2.5:1"]
  },
  "characteristics": ["smooth", "melodic", "clean", "forward"],
  "genreTags": ["hip-hop/rap", "R&B", "melodic"],
  "a/bTesting": {
