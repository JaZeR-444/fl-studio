      "tags": ["hip-hop/rap", "R&B", "subtle"]
    },
    "warmPad": {
      "description": "Classic 80s warmth for synth pads",
      "settings": {
        "rate": "0.35",
        "depth": "0.4",
        "dryWet": "0.4",
        "sync": "Off",
        "stereo": "70%"
      },
      "useCases": ["synth pads", "moody backgrounds", "electric textures"],
      "tags": ["moody", "upbeat", "80s vibe"]
    },
    "funkyRhythm": {
