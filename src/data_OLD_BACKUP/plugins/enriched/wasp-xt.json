            "res": 25,
            "routing": "parallel",
            "chorus": true
          }
        },
        "rnb": {
          "smoothBass": {
            "filter1": 35,
            "res": 28,
            "routing": "serial",
            "chorus": true
          },
          "keys": {
            "filter1": 65,
            "res": 18,
            "routing": "parallel",
            "chorus": true
          },
          "pad": {
            "filter1": 50,
            "res": 20,
            "routing": "parallel",
            "chorus": true
          }
        },
        "deepBassEDM": {
          "wobble": {
            "filter1": 35,
            "res": 50,
            "routing": "serial",
            "chorus": false
          },
          "supersaw": {
            "filter1": 50,
            "res": 35,
            "routing": "serial",
            "chorus": true
          },
          "texture": {
            "filter1": 45,
            "res": 40,
            "routing": "parallel",
            "chorus": true
          }
        }
      }
    },
    "sound-design-presets": {
      "classicEmulations": {
        "vintageWasp": {
          "osc1Wave": "sawtooth",
          "osc2Wave": "square",
          "oscMix": 50,
          "detune": 5,
          "filterCutoff": 60,
          "filterRes": 70,
          "envAmount": 80,
          "attack": 10,
          "decay": 200,
          "sustain": 40,
          "release": 300,
          "lfoRate": 4.0,
          "lfoDepth": 30,
          "unison": 0,
          "description": "Faithful original Wasp character"
        },
        "acidBass": {
          "osc1Wave": "sawtooth",
          "osc2Wave": "pulse",
          "oscMix": 70,
          "detune": 0,
          "filterCutoff": 40,
          "filterRes": 85,
          "envAmount": 90,
          "attack": 0,
