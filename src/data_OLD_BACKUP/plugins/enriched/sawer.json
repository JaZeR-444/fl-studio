  "rules": {
    "sawer-rules": {
      "pluginName": "Sawer",
      "rules": [
        {
          "if": "bass lacks weight",
          "then": [
            "increase sub level",
            "adjust sub phase",
            "reduce unison"
          ],
          "source": "manual-guided"
        },
        {
          "if": "sound is harsh",
          "then": [
            "reduce resonance",
            "use LP12",
            "lower cutoff"
          ],
          "source": "manual-guided"
        },
        {
          "if": "lead lacks motion",
          "then": [
            "enable sync",
            "route LFO to cutoff"
          ],
          "source": "best-practice"
        }
      ],
