        "morph": 50,
        "envelope": {
          "attack": 500,
          "decay": 1000,
          "sustain": 70,
          "release": 1500
        },
        "filter": {
          "cutoff": 3000,
          "resonance": 20
        }
      },
      "workflow": {
        "useCase": "Atmospheric pads",
        "steps": [
          "Set fundamental level",
          "Build harmonic series",
          "Add morphing movement",
          "Create slow envelope"
