  "settings": {
    "oscillator1": {
      "waveform": "triangle",
      "octave": "0",
      "detune": 0,
      "mix": 100
    },
    "oscillator2": {
      "waveform": "sine",
      "octave": "0",
      "detune": 4,
      "mix": 60
