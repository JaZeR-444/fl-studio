          "intensity": 75,
          "effect": "Sawtooth",
          "velocityRange": "110-127",
          "purpose": "Dominant snare crack",
          "tips": "Highest intensity element - snare is king in boom bap"
        },
        {
          "note": "F#3",
          "noteName": "Hi-Hat Closed",
          "intensity": 20,
          "effect": "Damper",
          "velocityRange": "60-90",
          "purpose": "Steady hi-hat groove",
