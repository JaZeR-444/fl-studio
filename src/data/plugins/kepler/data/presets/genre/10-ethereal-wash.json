    "lastUpdated": "2026-02-03",
    "author": "JaZeR",
    "presetName": "Ethereal Wash",
    "category": "genre",
    "genre": "ambient",
    "mood": "moody"
  },
  "settings": {
    "oscillator1": {
      "waveform": "sine",
      "octave": "-1",
      "detune": 0,
      "mix": 100
    },
    "oscillator2": {
      "waveform": "triangle",
      "octave": "-1",
      "detune": 12,
      "mix": 70
    },
    "oscillator3": {
      "waveform": "saw",
      "octave": "0",
      "detune": 25,
      "mix": 40
    },
    "filter": {
      "type": "lowpass",
      "cutoff": 2500,
      "resonance": 25,
      "drive": 5,
      "envAmt": 20,
      "envVel": 10
    },
    "envelope": {
      "attack": 500,
      "decay": 800,
      "sustain": 85,
      "release": 1500
    },
    "lfo": {
      "waveform": "sine",
      "rate": 0.15,
      "amt": 30,
      "dest": "pan"
    }
  },
  "chain": {
    "pre": ["Vintage Chorus - Mix 50%, Rate 0.3Hz"],
    "post": ["Fruily Reverb 2 - Cathedral, Decay 6s, Mix 30%"]
  },
  "genreTags": ["ambient", "moody", "cinematic", "spacey"],
  "a/bTesting": {
    "testA": "3 oscillators for width and depth",
    "testB": "2 oscillators for simpler arrangements"
  },
  "troubleshooting": {
    "phasingIssues": "Reduce LFO pan amount to 15%",
    "tooBright": "Filter cutoff to 1800Hz"
  }
