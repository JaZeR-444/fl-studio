  "settings": {
    "oscillator1": {
      "waveform": "sine",
      "octave": "0",
      "detune": 0,
      "mix": 100
    },
    "oscillator2": {
      "waveform": "triangle",
      "octave": "0",
      "detune": 3,
      "mix": 50
    },
    "filter": {
      "type": "lowpass",
      "cutoff": 2200,
      "resonance": 15,
      "drive": 5,
      "envAmt": 30,
      "envVel": 20
    },
    "envelope": {
      "attack": 50,
      "decay": 400,
      "sustain": 70,
      "release": 300
    },
    "lfo": {
      "waveform": "sine",
      "rate": 0.25,
      "amt": 15,
      "dest": "pan"
    }
  },
  "chain": {
    "pre": ["Soft clipper - 2dB input reduction"],
    "post": ["Reverb - Hall, Decay 2.5s, Pre-delay 30ms, Mix 20%"]
  },
  "genreTags": ["R&B", "moody", "smooth", "melodic"],
  "a/bTesting": {
    "testA": "Pan LFO on for movement",
    "testB": "Pan LFO off for centered mono"
  },
  "troubleshooting": {
    "harshHighs": "Reduce oscillator2 mix to 30%",
    "tooDark": "Increase filter cutoff to 2800Hz"
