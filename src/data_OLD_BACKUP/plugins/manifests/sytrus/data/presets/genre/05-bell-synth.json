{
  "name": "Bell Synth",
  "genre": "universal",
  "mood": "melodic",
  "description": "Ethereal bell tones with FM complexity",
  "parameters": {
    "op1": { "wave": 1, "mix": 70, "detune": 0, "phase": 0 },
    "op2": { "wave": 1, "mix": 60, "detune": 0, "phase": 0 },
    "op3": { "wave": 3, "mix": 50, "detune": 0, "phase": 0 },
    "op4": { "wave": 3, "mix": 45, "detune": 0, "phase": 0 },
    "op5": { "wave": 3, "mix": 40, "detune": 0, "phase": 0 },
    "op6": { "wave": 1, "mix": 0, "detune": 0, "phase": 0 },
    "cutoff": 6000,
    "resonance": 50,
    "drive": 5,
    "ampAttack": 3,
    "ampDecay": 800,
    "ampSustain": 30,
    "ampRelease": 400,
    "reverbMix": 50,
    "delayMix": 40
  },
  "workflow": {
    "useCase": "Ethereal bells and atmospheric accents",
    "steps": [
      "Sine waves as carriers for pure tone",
      "Higher operators as modulators for bell",
      "High cutoff (6000+ Hz) for brightness",
      "High resonance (45-55%) for bell tone",
      "Medium decay, low sustain for ring"
    ],
    "troubleshooting": [
      { "issue": "No bell tone", "fix": "Increase modulator operator levels" },
      { "issue": "Too bright", "fix": "Lower cutoff to 5000 Hz" },
      { "issue": "No sustain", "fix": "Increase sustain to 40%" }
    ]
  },
  "abTest": {
    "listenFor": "Pure, ringing bell tones",
    "duration": "Single notes with natural decay"
  }
}