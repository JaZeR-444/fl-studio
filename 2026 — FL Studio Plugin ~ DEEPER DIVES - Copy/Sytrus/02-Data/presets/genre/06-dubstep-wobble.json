  "workflow": {
    "useCase": "Dubstep wobble and growls",
    "steps": [
      "Sine carrier with saw modulation",
      "High resonance (70-80%) for wobble",
      "High drive (35-45%) for distortion",
      "LFO rate synced to bass pattern",
      "Filter cutoff as LFO target"
    ],
    "troubleshooting": [
      { "issue": "No wobble", "fix": "Check LFO routing to filter" },
      { "issue": "Not aggressive", "fix": "Increase drive to 50%" },
      { "issue": "Too chaotic", "fix": "Reduce LFO depth to 50%" }
    ]
  },
  "abTest": {
    "listenFor": "Aggressive wobble with distortion",
    "duration": "Wobble pattern with drop"
  }
