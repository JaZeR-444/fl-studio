{
  "name": "FM Bass",
  "genre": "EDM",
  "mood": "electric",
  "description": "Powerful FM bass with harmonics",
  "parameters": {
    "op1": { "wave": 1, "mix": 100, "detune": 0, "phase": 0 },
    "op2": { "wave": 2, "mix": 80, "detune": 0, "phase": 0 },
    "op3": { "wave": 2, "mix": 60, "detune": 0, "phase": 0 },
    "op4": { "wave": 1, "mix": 50, "detune": 0, "phase": 0 },
    "op5": { "wave": 2, "mix": 0, "detune": 0, "phase": 0 },
    "op6": { "wave": 2, "mix": 0, "detune": 0, "phase": 0 },
    "cutoff": 2000,
    "resonance": 40,
    "drive": 25,
    "ampAttack": 10,
    "ampDecay": 300,
    "ampSustain": 75,
    "ampRelease": 200,
    "reverbMix": 15,
    "delayMix": 10
  },
  "workflow": {
    "useCase": "Powerful bass lines and 808s",
    "steps": [
      "Operator 1 as carrier (sine)",
      "Operators 2-3 as modulators for harmonics",
      "Low cutoff (1800-2200 Hz) for deep bass",
      "Medium resonance (35-45%) for body",
      "Medium attack for punch"
    ],
    "troubleshooting": [
      { "issue": "No low end", "fix": "Increase op1 level to 100%" },
      { "issue": "Muddy", "fix": "Increase cutoff to 2500 Hz" },
      { "issue": "No character", "fix": "Increase op2-3 modulation" }
    ]
  },
  "abTest": {
    "listenFor": "Deep bass with FM harmonics",
    "duration": "Full bass line"
  }
}