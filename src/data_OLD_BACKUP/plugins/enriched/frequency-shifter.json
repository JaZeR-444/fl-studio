        "presetName": "Trap Riser Shift",
        "category": "genre",
        "genre": "trap",
        "mood": "dark"
      },
      "settings": {
        "frequencyShift": 800,
        "direction": "up",
        "mix": 75,
        "feedback": 0,
        "stereoMode": "sum",
        "drive": 5
      },
      "chain": {
        "pre": [
          "High-pass filter at 200Hz"
        ],
        "post": [
          "Fruily Limiter - Gentle limiting"
        ]
      },
      "workflow": "Automate frequency shift from 0 to 800Hz over 4-8 bars for riser builds. Use in pre-drop sections.",
