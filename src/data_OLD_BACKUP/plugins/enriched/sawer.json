  "parameters": {
    "sawer-params": {
      "pluginName": "Sawer",
      "type": "Subtractive",
      "polyphony": {
        "min": 1,
        "max": 24
      },
      "oscillators": [
        "mainSaw",
        "sub",
        "noise"
      ],
      "subOscillator": {
        "octaveRange": "-2 to +2",
        "controls": [
          "level",
          "phase",
          "detune"
        ]
      },
      "filter": {
        "modes": [
          "LP12",
          "LP24",
          "BP",
          "HP"
        ],
        "controls": [
          "cutoff",
          "resonance",
          "kbdTrack",
          "velTrack"
        ],
        "selfOscillates": true
      },
      "modulation": [
        "lfo",
        "adsr1",
        "adsr2",
        "matrix"
      ],
      "unison": {
        "voices": 8,
        "features": [
          "panning",
          "detune",
          "octaver"
        ]
      },
      "effects": [
        "chorus",
        "phaser",
        "delay",
        "reverb"
      ],
      "performance": [
