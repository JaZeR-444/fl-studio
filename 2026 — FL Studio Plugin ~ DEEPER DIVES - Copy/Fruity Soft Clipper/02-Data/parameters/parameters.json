{
  "pluginName": "Fruity Soft Clipper",
  "parameters": [
    {
      "id": "threshold",
      "name": "Threshold",
      "type": "knob",
      "range": {
        "min": -60,
        "max": 0,
        "unit": "dB"
      },
      "defaultValue": 0,
      "description": "Sets the ceiling level. Signals above this are soft-clipped."
    },
    {
      "id": "post_gain",
      "name": "Post Gain",
      "type": "knob",
      "range": {
        "min": 0,
        "max": 100,
        "unit": "%"
      },
      "defaultValue": 100,
      "description": "Output volume amplification."
    }
  ]
}
