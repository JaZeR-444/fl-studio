        {
          "section": "Envelope",
          "id": "release_1",
          "name": "Release 1",
          "range": {
            "min": 0,
            "max": 1000,
            "unit": "ms"
          },
          "description": "Accelerating release curve time."
        },
        {
          "section": "Envelope",
          "id": "release_2",
          "name": "Release 2",
          "range": {
            "min": 0,
